direction TB
class User {
  ObjectId _id
  String name
  String role
  String identifier
  String email
  String passwordHash
}
class Student {
  ObjectId _id
  ObjectId userId
  String registrationNumber
  Date dateOfBirth
  String phone
  ObjectId parentId
}
class Class {
  ObjectId _id
  String name
  String subject
  String description
  ObjectId teacherId
  ObjectId[] studentIds
  Number fee
  Boolean isActive
}
class ScheduleEntry {
  <<embedded>>
  String day
  String startTime
  String endTime
}
class Material {
  ObjectId _id
  String title
  String description
  String fileUrl
  String fileType
  ObjectId classId
  ObjectId uploadedBy
}
class Quiz {
  ObjectId _id
  String title
  String description
  ObjectId classId
  Number totalMarks
  ObjectId createdBy
  Date dueDate
  Boolean isPublished
  Number maxAttempts
}
class Question {
  <<embedded>>
  ObjectId _id
  String questionText
  String[] options
  String correctAnswer
  Number marks
}
class Result {
  ObjectId _id
  ObjectId studentId
  ObjectId quizId
  Number score
  Number totalMarks
  Date submittedAt
}
class Answer {
  <<embedded>>
  ObjectId questionId
  String selectedAnswer
  Boolean isCorrect
  Number marksAwarded
}
class Payment {
  ObjectId _id
  ObjectId studentId
  ObjectId classId
  Number amount
  Date paymentDate
  String paymentMethod
  String status
  String transactionReference
}
class Notification {
  ObjectId _id
  ObjectId userId
  String title
  String message
  String type
  Boolean isRead
}
